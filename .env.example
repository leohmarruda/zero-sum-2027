# Copy to `.env` in the repo root and fill values.
# Do NOT put comments on the same line as values.
# Backend and frontend both read this file only.

# LLM (via llmcall / LiteLLM / OpenRouter)
OPENROUTER_API_KEY=

# Banco de dados — leave empty to use local SQLite
# Example: sqlite+aiosqlite:///./dev.db
DATABASE_URL=

# Prod (Turso) — leave empty in local dev
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ambiente: dev | prod
ENVIRONMENT=dev

# Frontend (Vite). Local + Vercel same-origin API prefix.
VITE_API_BASE=/api
