# Copy to .env and fill values. Do NOT put comments on the same line as values.

# LLM (via llmcall / LiteLLM / OpenRouter)
OPENROUTER_API_KEY=

# Banco de dados — leave empty to use local SQLite
# Example: sqlite+aiosqlite:///./dev.db
DATABASE_URL=

# Prod (Turso) — leave empty in local dev
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ambiente: dev | prod
ENVIRONMENT=dev
